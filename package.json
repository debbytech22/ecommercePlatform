{
  "name": "ecommerce-platform",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && nest build order-service && nest build catalog-service && nest build inventory-service && nest build payment-service",
    "generate:contracts": "node scripts/generate-contracts.cjs",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/apps/ecommerce-platform/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:order-integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config apps/order-service/test/jest-e2e.json --runInBand --runTestsByPath apps/order-service/test/order-creation.e2e-spec.ts",
    "pretest:inventory-integration": "node -e \"const env = process.env; const missing = ['INVENTORY_INTEGRATION_TEST=true', 'INVENTORY_DB_HOST', 'INVENTORY_DB_PORT', 'INVENTORY_DB_USER', 'INVENTORY_DB_PASSWORD', 'RABBITMQ_URL'].filter((key) => key === 'INVENTORY_INTEGRATION_TEST=true' ? env.INVENTORY_INTEGRATION_TEST !== 'true' : !env[key]); if (missing.length || !env.INVENTORY_DB_NAME || !env.INVENTORY_DB_NAME.endsWith('_test')) { console.error('Inventory integration requires a dedicated *_test database, a dedicated RabbitMQ broker, and: ' + missing.join(', ')); process.exit(1); }\"",
    "test:inventory-integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath apps/inventory-service/test/inventory-phase3.integration.spec.ts",
    "migration:generate:orders": "typeorm-ts-node-commonjs migration:generate apps/order-service/src/database/migrations/OrderSchemaChanges -d apps/order-service/src/database/data-source.ts",
    "migration:show:orders": "typeorm-ts-node-commonjs migration:show -d apps/order-service/src/database/data-source.ts",
    "migration:run:orders": "typeorm-ts-node-commonjs migration:run -d apps/order-service/src/database/data-source.ts",
    "migration:revert:orders": "typeorm-ts-node-commonjs migration:revert -d apps/order-service/src/database/data-source.ts",
    "migration:show:catalog": "typeorm-ts-node-commonjs migration:show -d apps/catalog-service/src/database/data-source.ts",
    "migration:run:catalog": "typeorm-ts-node-commonjs migration:run -d apps/catalog-service/src/database/data-source.ts",
    "migration:revert:catalog": "typeorm-ts-node-commonjs migration:revert -d apps/catalog-service/src/database/data-source.ts",
    "migration:run:inventory": "typeorm-ts-node-commonjs migration:run -d apps/inventory-service/src/database/data-source.ts",
    "migration:show:inventory": "typeorm-ts-node-commonjs migration:show -d apps/inventory-service/src/database/data-source.ts",
    "migration:revert:inventory": "typeorm-ts-node-commonjs migration:revert -d apps/inventory-service/src/database/data-source.ts",
    "migration:generate:payments": "typeorm-ts-node-commonjs migration:generate apps/payment-service/src/database/migrations/PaymentSchemaChanges -d apps/payment-service/src/database/data-source.ts",
    "migration:run:payments": "typeorm-ts-node-commonjs migration:run -d apps/payment-service/src/database/data-source.ts",
    "migration:show:payments": "typeorm-ts-node-commonjs migration:show -d apps/payment-service/src/database/data-source.ts",
    "migration:revert:payments": "typeorm-ts-node-commonjs migration:revert -d apps/payment-service/src/database/data-source.ts",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --projects \"./apps/ecommerce-platform/test/jest-e2e.json\" \"./apps/api/test/jest-e2e.json\" \"./apps/api-gateway/test/jest-e2e.json\" \"./apps/order-service/test/jest-e2e.json\" \"./apps/inventory-service/test/jest-e2e.json\" \"./apps/payment-service/test/jest-e2e.json\" \"./apps/notification-service/test/jest-e2e.json\" \"./apps/catalog-service/test/jest-e2e.json\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/typeorm": "^12.0.2",
    "amqplib": "^2.2.0",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.3.2",
    "@rspack/core": "^2.2.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.18.3",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "webpack-node-externals": "^3.0.0"
  }
}
